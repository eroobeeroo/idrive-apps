[Unit]
Description=camera-inspect socket: an app connects and reads the camera inputs' report

[Socket]
# Every OAP app process has tm_oap_app as a supplementary group. Accept=yes:
# each connection starts one camera-inspect@.service, which writes its report
# to the connection and exits.
ListenStream=/dev/shm/camera-inspect/report.sock
DirectoryMode=0755
SocketMode=0660
SocketGroup=tm_oap_app
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
