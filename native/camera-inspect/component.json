{
  "id": "camera-inspect",
  "kind": "tool",
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "title": "Camera inspector",
  "description": "Reports, read only, what the head unit's camera inputs are (each capture node's driver, input, format and size, which process holds it, and the media graph), for Camera Probe and a camera app to come; it never takes a picture or changes a setting",
  "mguHmi": ["ID7"],
  "requires": { "mgu-deploy": "0.4.0" },
  "uninstallable": true,
  "build": ["make", "target"],
  "files": [
    { "path": "camera-inspect", "from": "build/target/camera-inspect", "mode": "0755" },
    { "path": "LICENSE", "from": "LICENSE", "mode": "0644" }
  ],
  "units": [
    { "name": "camera-inspect.socket", "from": "systemd/camera-inspect.socket" },
    { "name": "camera-inspect@.service", "from": "systemd/camera-inspect@.service" }
  ],
  "enable": [{ "unit": "camera-inspect.socket", "target": "sockets.target" }],
  "recmgr": ["camera-inspect"],
  "restart": []
}
